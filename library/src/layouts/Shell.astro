---
import "../styles/global.css";
import cfg from "../../library.config.mjs";
import { url } from "../lib/books";
interface Props { title?: string }
const { title } = Astro.props;
const site = cfg.title;
---
<html lang="th">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title ? `${title} · ${site}` : site}</title>
  </head>
  <body class="min-h-screen">
    <header class="border-b border-rule">
      <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-5 py-3 text-sm">
        <nav class="flex items-center gap-5"><a href={url("")} class="flex min-h-11 items-center whitespace-nowrap font-bold">{site}</a><a href={url("brain/")} class="flex min-h-11 items-center whitespace-nowrap text-accent-ink">brain</a></nav>
      </div>
    </header>
    <slot />
    <footer class="mx-auto max-w-7xl px-5 py-10 text-xs text-muted">{cfg.footer}</footer>
  </body>
</html>
